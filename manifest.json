{
  "manifest_version": 3,
  "name": "SiteSearch — Search Within Any Website",
  "version": "1.0.0",
  "description": "Instantly search within any website using Google's site: operator. One click, type your query, get results from just this site.",
  "permissions": ["activeTab"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+S"
      },
      "description": "Open SiteSearch popup"
    }
  }
}
